{
  "name": "banzuke-app",
  "version": "0.1.0",
  "description": "Static viewer for the grand sumo banzuke (Makuuchi and Juryo), refreshed automatically.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fetch-remote": "tsx scripts/fetch-banzuke.ts",
    "fetch-profiles": "tsx scripts/fetch-profiles.ts",
    "validate-data": "tsx scripts/validate-banzuke.ts public/latest-banzuke.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:tz": "TZ=America/Los_Angeles vitest run src/utils/dates.test.ts src/components/Hero && TZ=Pacific/Kiritimati vitest run src/utils/dates.test.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "check:css": "tsx scripts/check-css-modules.ts",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run check:css"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.0.0",
    "jsdom": "^27.4.0",
    "node-html-parser": "^9.0.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
