{
  "name": "banzuke-app",
  "version": "0.1.0",
  "description": "Static viewer for the grand sumo banzuke (Makuuchi and Juryo), refreshed automatically.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-stubs.ts",
    "preview": "vite preview",
    "fetch-remote": "tsx scripts/fetch-banzuke.ts",
    "fetch-profiles": "tsx scripts/fetch-profiles.ts",
    "fetch-stables": "tsx scripts/fetch-stables.ts",
    "subset-fonts": "tsx scripts/subset-fonts.ts",
    "make-sample": "tsx scripts/make-sample.ts",
    "archive-banzuke": "tsx scripts/archive-banzuke.ts",
    "backfill-archive": "tsx scripts/backfill-archive.ts",
    "fetch-results": "tsx scripts/fetch-results.ts",
    "validate-data": "tsx scripts/validate-banzuke.ts public/latest-banzuke.json",
    "glossary-gaps": "tsx scripts/glossary-gaps.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:tz": "TZ=America/Los_Angeles vitest run src/utils/dates.test.ts src/components/Hero && TZ=Pacific/Kiritimati vitest run src/utils/dates.test.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"e2e/**/*.ts\" playwright.config.ts",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.e2e.json",
    "check:css": "tsx scripts/check-css-modules.ts",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run check:css"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.9",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  }
}
